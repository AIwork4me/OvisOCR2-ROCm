# Machine-specific overrides for the OvisOCR2 adapter. Copy to .env.local and
# edit. .env.local is gitignored — never commit it.
#
# The adapter (adapter/run_adapter.py) reads these via adapter_config.py, which
# in turn honors the OVISOCR2_* env vars below. CLI flags override all of these.

# Inference backend: vllm (real, needs GPU) | smoke (no-GPU placeholder).
OVISOCR2_BACKEND=vllm

# Weights: a HF/ModelScope repo id (vLLM auto-downloads) OR a local directory.
OVISOCR2_WEIGHTS=/root/models/OvisOCR2

# GPU selection (which physical gfx1100 to use).
# HIP_VISIBLE_DEVICES=0
